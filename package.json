{
  "name": "drazta",
  "version": "0.1.0",
  "description": "Web scraping and structured extraction engine — capability-routed engines, hedged fallback, SSRF-safe fetching, and tidy typed output.",
  "type": "module",
  "license": "MIT",
  "author": "Muhammad Apriandito",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apriandito/drazta.git"
  },
  "homepage": "https://github.com/apriandito/drazta#readme",
  "bugs": {
    "url": "https://github.com/apriandito/drazta/issues"
  },
  "keywords": [
    "scraping",
    "scraper",
    "crawler",
    "web-scraping",
    "structured-extraction",
    "markdown",
    "html-to-markdown",
    "json-ld",
    "table-extraction",
    "playwright",
    "llm",
    "duckdb"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "drazta": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "workspaces": [
    "ui"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "ui": "npm run build && npm --workspace drazta-ui run dev",
    "ui:build": "npm run build && npm --workspace drazta-ui run build",
    "dev": "tsx watch src/server/api.ts",
    "serve": "tsx src/server/api.ts",
    "cli": "tsx src/cli.ts",
    "agent": "tsx src/agent-cli.ts",
    "jobs": "tsx src/jobs-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/smoke.ts && tsx scripts/smoke-crawl.ts && tsx scripts/smoke-dates.ts && tsx scripts/smoke-article.ts && tsx scripts/smoke-product.ts && tsx scripts/smoke-tables.ts && tsx scripts/smoke-tidy.ts && tsx scripts/smoke-deep.ts && tsx scripts/smoke-quality.ts && tsx scripts/smoke-engine.ts && tsx scripts/smoke-camoufox.ts && tsx scripts/smoke-jobs.ts && tsx scripts/smoke-agent.ts",
    "test:duck": "tsx scripts/smoke-duck.ts",
    "test:live": "tsx scripts/verify-live.ts",
    "test:camoufox": "tsx scripts/verify-camoufox.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.0.0",
    "@hono/node-server": "^1.13.0",
    "ai": "^4.0.0",
    "cheerio": "^1.0.0",
    "exceljs": "^4.4.0",
    "hono": "^4.6.0",
    "joplin-turndown-plugin-gfm": "^1.0.12",
    "jsdom": "^30.0.1",
    "turndown": "^7.2.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "optionalDependencies": {
    "@duckdb/node-api": "^1.5.5-r.3",
    "camoufox-js": "^0.12.0",
    "playwright": "1.60.0"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
